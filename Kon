local NexUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/trttttttt/Something/refs/heads/main/Some2"))()

local Window = NexUI:CreateWindow({
    Title      = "Roll Script",
    SubTitle   = "ReqId Loop",
    ConfigSave = false,
})

local Tab = Window:CreateTab("Main")

-- ══════════════════
--  VARIABLES
-- ══════════════════
local looping  = false
local currentId = 9  -- mula dari 9
local delay    = 0   -- delay antara setiap loop (0 = secepat mungkin)

-- ══════════════════
--  UI ELEMENTS
-- ══════════════════

-- Label tunjuk reqId semasa
local statusLabel = Tab:CreateLabel("Status: OFF  |  reqId: " .. currentId)

Tab:CreateSection("Settings")

-- Slider tukar starting number
Tab:CreateSlider({
    Name     = "Start From (reqId)",
    Min      = 1,
    Max      = 999,
    Default  = 9,
    ID       = "start_id",
    Callback = function(v)
        if not looping then
            currentId = v
            statusLabel:Set("Status: OFF  |  reqId: " .. currentId)
        end
    end,
})

-- Slider tukar delay
Tab:CreateSlider({
    Name     = "Delay (ms)",
    Min      = 0,
    Max      = 1000,
    Default  = 0,
    Suffix   = "ms",
    ID       = "loop_delay",
    Callback = function(v)
        delay = v / 1000
    end,
})

Tab:CreateSection("Control")

-- Toggle on/off loop
Tab:CreateToggle({
    Name     = "Loop reqId",
    Default  = false,
    ID       = "loop_toggle",
    Callback = function(state)
        looping = state

        if state then
            -- Mula loop dalam task baru
            task.spawn(function()
                while looping do
                    local args = {
                        [1] = {
                            ["reqId"] = currentId
                        }
                    }

                    pcall(function()
                        game:GetService("ReplicatedStorage").Remotes.RollRevealed:FireServer(unpack(args))
                    end)

                    -- Update label
                    statusLabel:Set("Status: ON  |  reqId: " .. currentId)

                    currentId = currentId + 1

                    if delay > 0 then
                        task.wait(delay)
                    else
                        task.wait() -- next frame je
                    end
                end

                statusLabel:Set("Status: OFF  |  reqId: " .. currentId)
            end)

            Window:Notify("Loop ON", "Mula dari reqId " .. currentId, 2)
        else
            Window:Notify("Loop OFF", "Berhenti kat reqId " .. currentId, 2)
        end
    end,
})

-- Button reset balik ke 9
Tab:CreateButton({
    Name     = "Reset reqId to 9",
    Callback = function()
        if not looping then
            currentId = 9
            statusLabel:Set("Status: OFF  |  reqId: " .. currentId)
            Window:Notify("Reset", "reqId reset ke 9", 2)
        else
            Window:Notify("Tunggu", "Stop loop dulu sebelum reset", 2)
        end
    end,
})

-- Button set manual
Tab:CreateInput({
    Name        = "Set reqId Manual",
    Placeholder = "Masuk nombor...",
    OnEnter     = true,
    ID          = "manual_id",
    Callback    = function(v)
        local num = tonumber(v)
        if num and not looping then
            currentId = math.floor(num)
            statusLabel:Set("Status: OFF  |  reqId: " .. currentId)
            Window:Notify("Set", "reqId = " .. currentId, 2)
        end
    end,
})
