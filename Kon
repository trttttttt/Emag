                    end
                else
                    Rayfield:Notify({ Title = "Boss Summon", Content = "Couldn't find " .. selectedBossName .. " after summon.", Duration = 3 })
                end

                task.wait(0.2) -- brief pause before next summon cycle
            end
        end)
    end

