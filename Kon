--========================================
-- TAB 4: AUTO REROLL TRAIT
--========================================
local TraitTab = Window:CreateTab("Auto Reroll Trait", 7733960981)

local traitTargets = {
    "Common", "Epic", "Legendary", "Mythic", "Secret",
    "Fighter", "Money Maker", "Rich", "Money Master", "Golden Worker",
    "Boss Slayer", "Ultimate", "Speed Cleaner", "Perfect", "Strong", "Hard Worker",
}

local traitNumbers = { "1", "2", "3", "4", "5" }

local selectedTraitTargets = {}
local selectedTraitNumber = nil
local traitRerollRunning = false
local traitRerollDelay = 0.3

TraitTab:CreateDropdown({
    Name = "Target Rarity / Trait (Rujukan)",
    Options = traitTargets,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "TraitDropdown",
    Callback = function(Options)
        selectedTraitTargets = Options
    end,
})

TraitTab:CreateParagraph({
    Title = "Nota",
    Content = "Dropdown 'Target Rarity/Trait' di atas rujukan je (senarai dari TraitConfig). Remote reroll cuma terima nombor slot — pilih nombor kat bawah untuk tentukan slot mana nak di-reroll.",
})

TraitTab:CreateDropdown({
    Name = "Pilih Nombor",
    Options = traitNumbers,
    CurrentOption = {},
    MultipleOptions = false,
    Flag = "TraitNumberDropdown",
    Callback = function(Option)
        if type(Option) == "table" then
            selectedTraitNumber = tonumber(Option[1])
        else
            selectedTraitNumber = tonumber(Option)
        end
    end,
})

local AutoRerollToggle

AutoRerollToggle = TraitTab:CreateToggle({
    Name = "Auto Reroll Trait",
    CurrentValue = false,
    Flag = "AutoRerollToggle",
    Callback = function(Value)
        if Value and not selectedTraitNumber then
            Rayfield:Notify({
                Title = "Pilih Nombor Dulu",
                Content = "Sila pilih nombor (1-5) sebelum start Auto Reroll.",
                Duration = 4,
            })
            traitRerollRunning = false
            if AutoRerollToggle and AutoRerollToggle.Set then
                AutoRerollToggle:Set(false)
            end
            return
        end

        traitRerollRunning = Value
        if traitRerollRunning then
            task.spawn(function()
                while traitRerollRunning do
                    Remotes.RequestTraitReroll:FireServer(selectedTraitNumber)
                    task.wait(traitRerollDelay)
                end
            end)
        end
    end,
})

TraitTab:CreateSlider({
    Name = "Reroll Delay",
    Range = { 0.1, 2 },
    Increment = 0.1,
    Suffix = "s",
    CurrentValue = 0.3,
    Flag = "TraitRerollDelay",
    Callback = function(Value)
        traitRerollDelay = Value
    end,
})

--========================================
-- TAB 5: SETTING (Anti-AFK)
--========================================
local SettingTab = Window:CreateTab("Setting", 4400511784)

local VirtualUser = game:GetService("VirtualUser")
local afkConnection = nil

local function enableAntiAFK()
    if afkConnection then return end
    afkConnection = LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

local function disableAntiAFK()
    if afkConnection then
        afkConnection:Disconnect()
        afkConnection = nil
    end
end

SettingTab:CreateToggle({
    Name = "Anti AFK",
    CurrentValue = true,
    Flag = "AntiAFKToggle",
    Callback = function(Value)
        if Value then
            enableAntiAFK()
        else
            disableAntiAFK()
        end
    end,
})

enableAntiAFK() -- default ON

Rayfield:Notify({
    Title = "Script Loaded",
    Content = "Semua tab dah siap: Main, Auto Buy Potion, Boss Auto Join, Auto Reroll Trait, Setting.",
    Duration = 5,
})
