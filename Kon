-- CleaningScrub Auto Script (Rayfield UI + Anti-AFK)
-- Loop dari 1 sampai 20, lepas 20 ulang balik dari 1

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "CleaningScrub Auto",
    LoadingTitle = "CleaningScrub Auto",
    LoadingSubtitle = "by Lol",
    ConfigurationSaving = {
        Enabled = false
    },
    Discord = {
        Enabled = false
    },
    KeySystem = false
})

local MainTab = Window:CreateTab("Main", 4483362458)

local Remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes")
local LocalPlayer = game:GetService("Players").LocalPlayer

local autoRunning = false
local delayTime = 0 -- 0 = task.wait minimum (satu frame)
local burstCount = 10 -- berapa kali fire sebelum wait sekali (ni yang buat lagi laju)

MainTab:CreateToggle({
    Name = "Auto Fire (Loop 1-20)",
    CurrentValue = false,
    Flag = "AutoFireToggle",
    Callback = function(Value)
        autoRunning = Value
        if Value then
            task.spawn(function()
                local n = 1
                while autoRunning do
                    for i = 1, burstCount do
                        local args = { [1] = n }
                        Remotes.CleaningScrub:FireServer(unpack(args))

                        n += 1
                        if n > 20 then
                            n = 1
                        end
                    end

                    task.wait(delayTime)
                end
            end)
        end
    end,
})

MainTab:CreateSlider({
    Name = "Fire Delay",
    Range = { 0, 1 },
    Increment = 0.01,
    Suffix = "s",
    CurrentValue = 0,
    Flag = "FireDelay",
    Callback = function(Value)
        delayTime = Value
    end,
})

MainTab:CreateSlider({
    Name = "Fires Per Tick (Burst)",
    Range = { 1, 30 },
    Increment = 1,
    Suffix = "x",
    CurrentValue = 10,
    Flag = "BurstCount",
    Callback = function(Value)
        burstCount = Value
    end,
})

local spinRunning = false

MainTab:CreateToggle({
    Name = "Auto Spin",
    CurrentValue = false,
    Flag = "AutoSpinToggle",
    Callback = function(Value)
        spinRunning = Value
        if Value then
            task.spawn(function()
                while spinRunning do
                    Remotes.RequestSpin:FireServer()
                    task.wait(1)
                end
            end)
        end
    end,
})

--========================================
-- TAB 2: AUTO BUY POTION
--========================================
local PotionTab = Window:CreateTab("Auto Buy Potion", 6031280882)

local potionList = {
    "Mutation1", "Mutation2", "Mutation3",
    "Luck1", "Luck2", "Luck3",
    "Cash1", "Cash2", "Cash3",
    "Scrub1", "Scrub2", "Scrub3",
}

local selectedPotions = {}
local buyRunning = false
local buyDelay = 0.5

PotionTab:CreateDropdown({
    Name = "Pilih Potion",
    Options = potionList,
    CurrentOption = {},
    MultipleOptions = true,
    Flag = "PotionDropdown",
    Callback = function(Options)
        selectedPotions = Options
    end,
})

PotionTab:CreateToggle({
    Name = "Auto Buy Potion",
    CurrentValue = false,
    Flag = "AutoBuyToggle",
    Callback = function(Value)
        buyRunning = Value
        if Value then
            task.spawn(function()
                while buyRunning do
                    if #selectedPotions == 0 then
                        task.wait(1)
                    else
                        for _, potion in ipairs(selectedPotions) do
                            if not buyRunning then break end
                            Remotes.RequestBuyPotion:FireServer(potion)
                            task.wait(buyDelay)
                        end
                    end
                end
            end)
        end
    end,
})

PotionTab:CreateSlider({
    Name = "Buy Delay",
    Range = { 0.1, 3 },
    Increment = 0.1,
    Suffix = "s",
    CurrentValue = 0.5,
    Flag = "BuyDelay",
    Callback = function(Value)
        buyDelay = Value
    end,
})

