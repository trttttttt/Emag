    local function findQuestEnemy(targetName)
        if not targetName then return nil end
        local hrp = getHRP()
        if not hrp then return nil end

        local enemiesFolder = workspace:FindFirstChild("Enemies")
        if not enemiesFolder then
            warn("[QuestDebug] workspace.Enemies folder not found!")
            return nil
        end

        local nameLower = targetName:lower()
        local closest, closestDist = nil, math.huge
        local seenNames = {}

        for _, mob in ipairs(enemiesFolder:GetChildren()) do
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            table.insert(seenNames, mob.Name .. (hum and (" (HP:" .. hum.Health .. ")") or " (no humanoid)"))
            if hum and hum.Health > 0 and mobHRP then
                local mobNameLower = mob.Name:lower()
                if mobNameLower == nameLower or mobNameLower:find(nameLower, 1, true) or nameLower:find(mobNameLower, 1, true) then
                    local dist = (hrp.Position - mobHRP.Position).Magnitude
                    if dist < closestDist then
                        closest = mob
                        closestDist = dist
                    end
                end
            end
        end

        if not closest then
            warn("[QuestDebug] Looking for: '" .. targetName .. "' | Found in Enemies folder: " .. table.concat(seenNames, ", "))
        end

        return closest
    end

    local function isTargetAlive(mob)
        if not mob then return false end
        if not mob.Parent then return false end
        local hum = mob:FindFirstChildOfClass("Humanoid")
        local mobHRP = mob:FindFirstChild("HumanoidRootPart")
        if not hum or not mobHRP then return false end
        if hum.Health <= 0 then return false end
        return true
    end

    local function startQuestKillLoop()
        if mobKillThread then task.cancel(mobKillThread); mobKillThread = nil end
        mobKillThread = task.spawn(function()
            local notFoundTime   = 0
            local portalIndex    = 1
            local blacklist      = {}   -- islands with no target found, skipped until toggle OFF
            local currentIsland  = nil  -- island we are on right now (for blacklisting on failure)

            local function nextNonBlacklistedIndex(fromIndex)
                for i = 0, #PORTAL_IDS - 1 do
                    local idx = ((fromIndex - 1 + i) % #PORTAL_IDS) + 1
                    if not blacklist[PORTAL_IDS[idx]] then
                        return idx
                    end
                end
                return fromIndex -- all blacklisted, fall back to given index
            end

            while mobKillActive do
                if not isTargetAlive(currentTarget) then
                    currentTarget = findQuestEnemy(selectedQuestTarget)
                end

                if currentTarget then
                    notFoundTime = 0
                    TargetLabel:Set("Current Target: " .. currentTarget.Name)

                    local hrp = getHRP()
                    local mobHRP = currentTarget:FindFirstChild("HumanoidRootPart")
                    if hrp and mobHRP then
                        hrp.CFrame = mobHRP.CFrame * CFrame.new(0, 0, 3)
                    end
                    fireM1()
                else
                    -- Not found — track how long, and cycle islands
                    -- via TeleportToPortal if it's been too long.
                    notFoundTime = notFoundTime + 0.1
                    TargetLabel:Set("Current Target: Searching for '" .. selectedQuestTarget .. "'...")

                    if notFoundTime >= 0.8 then
                        -- Safety: re-check for the target ONE more time right
                        -- before teleporting. If it exists now (e.g. it just
                        -- respawned), abort the teleport and keep fighting here.
                        local doubleCheck = findQuestEnemy(selectedQuestTarget)
                        if doubleCheck then
                            currentTarget = doubleCheck
                            notFoundTime = 0
                        else
                            -- Blacklist the island we just failed to find the target on
                            if currentIsland then
                                blacklist[currentIsland] = true
                            end

                            portalIndex = nextNonBlacklistedIndex(portalIndex)
                            local portalId = PORTAL_IDS[portalIndex]
                            currentIsland = portalId

                            pcall(function()
                                RS.Remotes.TeleportToPortal:FireServer(portalId)
                            end)
                            TargetLabel:Set("Current Target: Not found, teleporting to " .. portalId .. "...")

                            portalIndex = portalIndex + 1
                            if portalIndex > #PORTAL_IDS then portalIndex = 1 end

                            notFoundTime = 0
                            task.wait(0.6) -- give time to load into the island
                        end
                    end
                end

                task.wait(0.1)
            end
            TargetLabel:Set("Current Target: None")
        end)
    end

