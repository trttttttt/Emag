    --  TAB: UNDYNE MINIGAME (auto-dodge)
    -- ════════════════════════════════════════════════════════
    local UndyneTab = Window:CreateTab("Undyne Minigame", "shield")

    local function getTouchPadButtons()
        local gui = LP:FindFirstChild("PlayerGui")
        local mg = gui and gui:FindFirstChild("UndyneMinigame")
        local pad = mg and mg:FindFirstChild("TouchDirectionPad", true)
        if not pad then
            pad = mg and mg:FindFirstChild("TouchDirectionPad")
        end
        if not pad then return nil end
        return {
            Top    = pad:FindFirstChild("Top"),
            Bottom = pad:FindFirstChild("Bottom"),
            Left   = pad:FindFirstChild("Left"),
            Right  = pad:FindFirstChild("Right"),
        }
    end

    local function findMinigameGui()
        local gui = LP:FindFirstChild("PlayerGui")
        return gui and gui:FindFirstChild("UndyneMinigame")
    end

    local function isMinigameOpen()
        local mg = findMinigameGui()
        return mg and mg.Enabled == true
    end

    local function clickStartButton()
        local mg = findMinigameGui()
        if not mg then return false end
        local frame = mg:FindFirstChild("Minigame") and mg.Minigame:FindFirstChild("Frame")
        local startBtn = frame and frame:FindFirstChild("Button")
        if not startBtn then return false end
        return pcall(function()
            if firesignal then
                firesignal(startBtn.Activated)
            else
                startBtn.Activated:Fire()
            end
        end)
    end

    -- Determine which direction a spear came from using its spawn anchor
    -- (xScale/yScale set in the game's own spawnSpear function):
    --   Top:    xScale=0.5, yScale=0   |  Bottom: xScale=0.5, yScale=1
    --   Left:   xScale=0,   yScale=0.5 |  Right:  xScale=1,   yScale=0.5
    local function getSpearDirection(spear)
        local pos = spear.Position
        local xS, yS = pos.X.Scale, pos.Y.Scale
        if math.abs(yS - 0) < 0.1 and math.abs(xS - 0.5) < 0.2 then
            return "Top"
        elseif math.abs(yS - 1) < 0.1 and math.abs(xS - 0.5) < 0.2 then
            return "Bottom"
        elseif math.abs(xS - 0) < 0.1 and math.abs(yS - 0.5) < 0.2 then
            return "Left"
        elseif math.abs(xS - 1) < 0.1 and math.abs(yS - 0.5) < 0.2 then
            return "Right"
        end
        return nil
    end

    local autoUndyneActive = false
    local autoUndyneConn   = nil
    local lastClickedSpear = nil

    UndyneTab:CreateLabel("Auto-detects when the Undyne minigame opens, starts it, and reads the actual spear instances live to shield in real time (not a timing guess).")

    UndyneTab:CreateToggle({
        Name = "Auto Undyne Minigame",
        CurrentValue = false,
        Flag = "AutoUndyneToggle",
        Callback = function(state)
            autoUndyneActive = state
            if state then
                if autoUndyneConn then autoUndyneConn:Disconnect(); autoUndyneConn = nil end

                -- Poll separately for the minigame opening + Start click
                task.spawn(function()
                    while autoUndyneActive do
                        if isMinigameOpen() then
                            clickStartButton()
                            task.wait(1)
                        end
                        task.wait(0.5)
                    end
                end)

                autoUndyneConn = RunService.RenderStepped:Connect(function()
                    if not autoUndyneActive then return end
                    local mg = findMinigameGui()
                    if not mg or not mg.Enabled then return end

                    local frame = mg:FindFirstChild("Minigame") and mg.Minigame:FindFirstChild("Frame")
                    if not frame then return end

                    local heart = frame:FindFirstChild("Heart")
                    local shield = frame:FindFirstChild("Block") and frame.Block:FindFirstChild("Shield")
                    if not heart or not shield then return end

                    local heartPos = heart.AbsolutePosition
                    local heartSize = heart.AbsoluteSize

                    -- Find the first spear whose bounding box overlaps the Heart's
                    -- (any ImageLabel/Frame child of `frame` that isn't the hidden
                    -- template, Heart, Block, Button, or Close)
                    local closestSpear = nil
                    for _, child in ipairs(frame:GetChildren()) do
                        if child.Visible and child:IsA("GuiObject")
                            and child.Name ~= "Heart" and child.Name ~= "Block"
                            and child.Name ~= "Button" and child.Name ~= "Close" then

                            -- Same AABB overlap check the game itself uses for
                            -- collision, with a small buffer (in pixels) so we
                            -- click just BEFORE the game's own check lands,
                            -- not exactly on the same frame.
                            local buffer = 12
                            local sPos, sSize = child.AbsolutePosition, child.AbsoluteSize
                            local hPos, hSize = heartPos, heartSize

                            local overlapsX = sPos.X < hPos.X + hSize.X + buffer and sPos.X + sSize.X + buffer > hPos.X
                            local overlapsY = sPos.Y < hPos.Y + hSize.Y + buffer and sPos.Y + sSize.Y + buffer > hPos.Y

                            if overlapsX and overlapsY then
                                closestSpear = child
                                break -- act on the first one touching — no need to compare distances
                            end
                        end
                    end

                    if closestSpear then
                        local dir = getSpearDirection(closestSpear)
                        if dir and closestSpear ~= lastClickedSpear then
                            local buttons = getTouchPadButtons()
                            local btn = buttons and buttons[dir]
                            if btn then
                                pcall(function()
                                    if firesignal then
                                        firesignal(btn.MouseButton1Down)
                                    else
                                        btn.MouseButton1Down:Fire()
                                    end
                                end)
                            end
                            lastClickedSpear = closestSpear
                        end
                    end
                end)

                Rayfield:Notify({ Title = "Undyne", Content = "Auto Minigame ON — live spear tracking", Duration = 3 })
            else
                if autoUndyneConn then autoUndyneConn:Disconnect(); autoUndyneConn = nil end
                Rayfield:Notify({ Title = "Undyne", Content = "Auto Minigame OFF", Duration = 2 })
            end
        end,
    })

