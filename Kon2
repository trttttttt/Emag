    -- Auto Fish: Cast then Shake repeatedly (confirmed via remote spy).
    -- RE_FishingMinigame:FireServer("Cast", progress:number(0-1), castPosition:Vector3)
    -- RE_FishingMinigame:FireServer("Shake", count:number)
    local autoFishActive = false
    local autoFishThread = nil

    local function castLine()
        local hrp = getHRP()
        if not hrp then return false end
        -- Cast a bit in front of the player, along the water's surface (y ~ 0 relative)
        local castPos = hrp.Position + (hrp.CFrame.LookVector * 15)
        return pcall(function()
            RS.Remotes.RE_FishingMinigame:FireServer("Cast", 0.3, castPos)
        end)
    end

    local function shakeReel(count)
        return pcall(function()
            RS.Remotes.RE_FishingMinigame:FireServer("Shake", count)
        end)
    end

    FishingTab:CreateToggle({
        Name = "Auto Fish (Cast + Shake loop)",
        CurrentValue = false,
        Flag = "AutoFishToggle",
        Callback = function(state)
            autoFishActive = state
            if state then
                if autoFishThread then task.cancel(autoFishThread); autoFishThread = nil end
                autoFishThread = task.spawn(function()
                    local shakeCount = 1
                    while autoFishActive do
                        castLine()
                        task.wait(1.5) -- wait for bite window to start

                        -- Shake repeatedly to reel in — most fishing minigames
                        -- need several shakes in a row while the fish is on.
                        for i = 1, 8 do
                            if not autoFishActive then break end
                            shakeReel(shakeCount)
                            shakeCount = shakeCount + 1
                            task.wait(0.4)
                        end

                        task.wait(1) -- brief pause before next cast
                    end
                end)
                Rayfield:Notify({ Title = "Fishing", Content = "Auto Fish ON", Duration = 2 })
            else
                if autoFishThread then task.cancel(autoFishThread); autoFishThread = nil end
                Rayfield:Notify({ Title = "Fishing", Content = "Auto Fish OFF", Duration = 2 })
            end
        end,
    })

