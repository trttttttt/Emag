    -- NOTE: exact remote name + how the client reads "what race did I get"
    -- were not in the config data (only race stat definitions were).
    -- This tries common patterns and checks common leaderstats/attribute
    -- locations for the result. If it doesn't match your game, tell me
    -- the real remote/attribute name and I'll wire it directly.
    local function tryRerollRace()
        local attempts = {
            function() RS.Remotes.Functions.Reroll:InvokeServer("Race") end,
            function() RS.Remotes.Functions.RaceReroll:InvokeServer() end,
            function() RS.Remotes.Events.Reroll:FireServer("Race") end,
        }
        for _, attempt in ipairs(attempts) do
            local ok = pcall(attempt)
            if ok then return true end
        end
        return false
    end

    local function getCurrentRace()
        local ok, result = pcall(function()
            return LP:GetAttribute("Race")
                or (LP:FindFirstChild("leaderstats") and LP.leaderstats:FindFirstChild("Race") and LP.leaderstats.Race.Value)
        end)
        if ok then return result end
        return nil
    end

    local autoRerollActive = false
