    task.spawn(function()
        task.wait(2) -- let all tabs/elements build first
        local lastSnapshot = {}
        while true do
            task.wait(1)
            local changed = false
            for flagName, element in pairs(Rayfield.Flags) do
                local ok, currentVal = pcall(function()
                    return element.CurrentValue or element.CurrentOption or element.CurrentKeybind
                end)
                if ok and currentVal ~= nil then
                    local encoded = HttpService:JSONEncode(currentVal)
                    if lastSnapshot[flagName] ~= encoded then
                        lastSnapshot[flagName] = encoded
                        SavedConfig[flagName] = currentVal
                        changed = true
                    end
                end
            end
            if changed then
                pcall(function()
                    writefile(CONFIG_FILE, HttpService:JSONEncode(SavedConfig))
                end)
            end
        end
    end)

    local function loadSavedFlag(flagName)
        if SavedConfig[flagName] == nil then return end
        pcall(function()
            Rayfield.Flags[flagName]:Set(SavedConfig[flagName])
        end)
    end

