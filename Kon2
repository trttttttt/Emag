    local function tryRedeemCode(code)
        local attempts = {
            function() RS.Remotes.Functions.Redeem:InvokeServer(code) end,
            function() RS.Remotes.Functions.RedeemCode:InvokeServer(code) end,
            function() RS.Remotes.Events.Redeem:FireServer(code) end,
            function() RS.Remotes.Events.RedeemCode:FireServer(code) end,
        }
        for _, attempt in ipairs(attempts) do
            local ok = pcall(attempt)
            if ok then return true end
        end
        return false
    end

