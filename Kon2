                    Rayfield:Notify({ Title = "Reroll", Content = "Pick a target race first!", Duration = 3 })
                    autoRerollActive = false
                    return
                end
                if autoRerollThread then task.cancel(autoRerollThread); autoRerollThread = nil end
                autoRerollThread = task.spawn(function()
                    while autoRerollActive do
                        local current = getCurrentRace()
                        if current == targetRace then
                            Rayfield:Notify({ Title = "Reroll", Content = "Got " .. targetRace .. "! Stopping.", Duration = 3 })
                            autoRerollActive = false
                            pcall(function() Rayfield.Flags["AutoRerollToggle"]:Set(false) end)
                            break
