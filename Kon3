    -- ---- hook / unhook ----
    local function startHook()
        if RemoteSpy.hooked then
            return
        end
        if not hookmetamethod and not (getrawmetatable and setreadonly) then
            warn("RemoteSpy: exploit does not support metamethod hooking")
            return
        end

        -- IMPORTANT: never call self:IsA(...) or other colon-methods on `self` inside
        -- this hook — :IsA() itself goes through __namecall and will recurse straight
        -- back into this same hook, causing a stack overflow crash. Reading self.ClassName
        -- is safe because plain property reads go through __index, not __namecall.
        local function onNamecall(self, ...)
            -- Guard: if original isn't ready yet (hook installed but assignment not
            -- finished), just no-op safely instead of calling nil and crashing.
            local orig = RemoteSpy.original
            if not orig then
                return
            end

            -- Wrap EVERYTHING below in pcall. This hook runs on every single namecall
            -- in the entire game (every :Connect, :FindFirstChild, :WaitForChild, etc
            -- from every script, every frame). Any uncaught error here — even one that
            -- would normally just be a script error — can bring down the whole client
            -- instead of failing safely, since it's happening inside a metamethod.
            pcall(function()
                local okMethod, method = pcall(function()
                    return getnamecallmethod and getnamecallmethod() or nil
                end)
                method = okMethod and method or nil

                if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" then
                    -- Reading self.ClassName / self.Name is a normal property read
                    -- (__index), NOT __namecall, so it's safe here and won't recurse.
                    -- self:IsA(...) would NOT be safe (that's itself a namecall).
                    local okClass, className = pcall(function()
                        return self.ClassName
                    end)
                    if okClass and (className == "RemoteEvent" or className == "RemoteFunction") then
                        local okName, nm = pcall(function() return self.Name end)
                        if okName then
                            local args = { ... }
                            local remote, isEvent = self, (className == "RemoteEvent")
                            task.spawn(function()
                                pcall(addLog, isEvent and "event" or "function", nm, args, remote, method)
                            end)
                        end
                    end
                end
            end)

            return orig(self, ...)
        end

        if hookmetamethod then
            RemoteSpy.original = hookmetamethod(game, "__namecall", onNamecall)
        else
            local mt = getrawmetatable(game)
            local old = mt.__namecall
            setreadonly(mt, false)
            mt.__namecall = onNamecall
            setreadonly(mt, true)
            RemoteSpy._rawMt = mt
            RemoteSpy.original = old -- set AFTER the hook is installed, matches hookmetamethod path timing
        end

        RemoteSpy.hooked = true
        spyToggle.Text = "ON"
        spyToggle.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
    end

    local function stopHook()
        if not RemoteSpy.hooked then
            return
        end
        if hookmetamethod then
            if RemoteSpy.original then
                hookmetamethod(game, "__namecall", RemoteSpy.original)
            end
        else
            local mt = RemoteSpy._rawMt or getrawmetatable(game)
            setreadonly(mt, false)
            mt.__namecall = RemoteSpy.original
            setreadonly(mt, true)
        end
        RemoteSpy.hooked = false
        spyToggle.Text = "OFF"
        spyToggle.BackgroundColor3 = Color3.fromRGB(220, 53, 69)
    end
    RemoteSpy.stopHook = stopHook

    spyToggle.Activated:Connect(function()
        if RemoteSpy.hooked then
            stopHook()
        else
            startHook()
        end
    end)

    clearLogsBtn.Activated:Connect(function()
        for _, entry in ipairs(RemoteSpy.logs) do
