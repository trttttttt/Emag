-- Auto-clean: strip comment lines (-- ... and --[[ ]]) + trim whitespace
local function cleanScript(src)
    if not src or src == "" then return "" end

    -- Remove multi-line comments --[[ ... ]] (and --[==[ ... ]==] variants)
    src = src:gsub("%-%-%[(=*)%[.-%]%1%]", "")

    -- Remove single-line comments, but only when -- is not inside a string
    local lines = {}
    for line in (src .. "\n"):gmatch("(.-)\n") do
        local inString, quoteChar = false, nil
        local cutAt = nil
        local i = 1
        local len = #line
        while i <= len do
            local c = line:sub(i, i)
            if inString then
                if c == "\\" then
                    i = i + 1 -- skip escaped char
                elseif c == quoteChar then
                    inString = false
                end
            else
                if c == '"' or c == "'" then
                    inString = true
                    quoteChar = c
                elseif c == "-" and line:sub(i + 1, i + 1) == "-" then
                    cutAt = i
                    break
                end
            end
            i = i + 1
        end
        if cutAt then
            line = line:sub(1, cutAt - 1)
        end
        table.insert(lines, line)
    end
    src = table.concat(lines, "\n")

    -- Trim leading/trailing whitespace (and blank lines) from whole script
    src = src:gsub("^%s+", ""):gsub("%s+$", "")

    return src
end
Data.cleanScript = cleanScript

