do
    local RemoteSpy = {}
    Data.RemoteSpy = RemoteSpy

    RemoteSpy.logs = {}          -- array of {Name, GenScript, Remote(weak), CallCount, LogRow}
    RemoteSpy.selected = nil
    RemoteSpy.hooked = false
    RemoteSpy.expanded = false
