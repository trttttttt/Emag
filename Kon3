    RemoteSpy.original = nil
    RemoteSpy.maxLogs = 200

    -- ---- serializer (trimmed-down port of SimpleSpy's v2s/t2s, safe subset) ----
    local indentStep = 4

    local function formatstr(s)
        s = s:gsub("\\", "\\\\"):gsub('"', '\\"'):gsub("\n", "\\n"):gsub("\t", "\\t")
        if #s > 300 then
            s = s:sub(1, 300) .. "...(truncated)"
        end
        return '"' .. s .. '"'
    end

    local function instancePath(inst)
        local ok, path = pcall(function()
            local parts = {}
            local cur = inst
            while cur and cur ~= game do
                table.insert(parts, 1, cur.Name)
                cur = cur.Parent
            end
            return "game." .. table.concat(parts, ".")
        end)
        if ok then
            return path
        end
        return "nil --[[unknown instance]]"
    end

    local v2s -- forward decl

    local function t2s(t, depth)
        depth = depth or 0
        if depth > 6 then
            return "{...}"
        end
        local parts = {}
        local n = 0
        for k, val in pairs(t) do
            n = n + 1
            if n > 50 then
                table.insert(parts, "-- (truncated, too many entries)")
                break
            end
            local keyStr
            if type(k) == "number" then
                keyStr = "[" .. k .. "]"
            elseif type(k) == "string" and k:match("^[%a_][%w_]*$") then
                keyStr = k
            else
                keyStr = "[" .. v2s(k, depth + 1) .. "]"
            end
            table.insert(parts, string.rep(" ", (depth + 1) * indentStep) .. keyStr .. " = " .. v2s(val, depth + 1))
        end
        if #parts == 0 then
            return "{}"
        end
        return "{\n" .. table.concat(parts, ",\n") .. "\n" .. string.rep(" ", depth * indentStep) .. "}"
    end

    v2s = function(v, depth)
        local ty = typeof(v)
        if ty == "string" then
            return formatstr(v)
        elseif ty == "number" or ty == "boolean" then
            return tostring(v)
        elseif ty == "nil" then
            return "nil"
        elseif ty == "Instance" then
            return instancePath(v)
        elseif ty == "table" then
            return t2s(v, depth)
        elseif ty == "Vector3" then
            return string.format("Vector3.new(%s, %s, %s)", v.X, v.Y, v.Z)
        elseif ty == "Vector2" then
            return string.format("Vector2.new(%s, %s)", v.X, v.Y)
        elseif ty == "CFrame" then
            return string.format("CFrame.new(%s, %s, %s)", v.X, v.Y, v.Z)
        elseif ty == "Color3" then
            return string.format("Color3.fromRGB(%d, %d, %d)", v.R * 255, v.G * 255, v.B * 255)
        elseif ty == "EnumItem" then
            return tostring(v)
        elseif ty == "function" then
            return "function() end --[[function]]"
        else
            return string.format("nil --[[%s]]", ty)
        end
    end

    local function genScript(remote, args, methodName)
        local ok, argStr = pcall(function()
            return "local args = " .. t2s(args, 0)
        end)
        if not ok then
            argStr = "local args = {} -- failed to serialize arguments"
        end
        local path = instancePath(remote)
        local call
        if methodName == "FireServer" then
            call = path .. ":FireServer(unpack(args))"
        else
            call = path .. ":InvokeServer(unpack(args))"
        end
        return argStr .. "\n\n" .. call
    end

