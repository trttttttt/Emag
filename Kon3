    end)

    -- stop the hook automatically if the whole UI gets destroyed
    screenGui.AncestryChanged:Connect(function()
        if not screenGui.Parent then
            pcall(stopHook)
        end
    end)
end

-- Switch Slot Function
local function switchToSlot(slotNum)
    if slotNum < 1 then slotNum = 20 end
    if slotNum > 20 then slotNum = 1 end
    
    Data.currentSlot = slotNum
    Data.slotDisplay.Text = "SLOT " .. slotNum
    Data.jumpInput.Text = tostring(slotNum)
    
    for j = 1, 20 do
        Data.slotFrames[j].frame.Visible = (j == slotNum)
    end
end

-- Navigation
Data.leftArrow.Activated:Connect(function()
    switchToSlot(Data.currentSlot - 1)
end)

Data.rightArrow.Activated:Connect(function()
    switchToSlot(Data.currentSlot + 1)
end)

Data.jumpButton.Activated:Connect(function()
    local targetSlot = tonumber(Data.jumpInput.Text)
    if targetSlot and targetSlot >= 1 and targetSlot <= 20 then
        switchToSlot(targetSlot)
        Data.jumpButton.Text = "✓"
        task.wait(0.3)
        Data.jumpButton.Text = "GO ➜"
    else
        Data.jumpButton.Text = "❌"
        task.wait(0.5)
        Data.jumpButton.Text = "GO ➜"
    end
end)

Data.jumpInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local targetSlot = tonumber(Data.jumpInput.Text)
        if targetSlot and targetSlot >= 1 and targetSlot <= 20 then
            switchToSlot(targetSlot)
        end
    end
end)

-- UI Toggle
local function closeUI()
    TweenService:Create(Data.mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint), 
        {Size = UDim2.new(0, 0, 0, 0)}):Play()
    task.wait(0.3)
    Data.mainFrame.Visible = false
end

local function openUI()
    Data.mainFrame.Visible = true
    Data.mainFrame.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(Data.mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back), 
        {Size = UDim2.new(0, 480, 0, 600)}):Play()
end

Data.openButton.Activated:Connect(function()
    if Data.openButtonDragMoved and Data.openButtonDragMoved() then return end
    if Data.mainFrame.Visible then closeUI() else openUI() end
end)

Data.closeButton.Activated:Connect(closeUI)

-- Loop System
Data.loopConnection = RunService.Heartbeat:Connect(function()
    local ct = tick()
    for i = 1, 20 do
        if loopActive[i] and ct - lastRunTime[i] >= slots[i].speed then
            lastRunTime[i] = ct
            pcall(function()
                local cleaned = cleanScript(slots[i].script)
                if cleaned ~= "" then
                    local func = loadstring(cleaned)
                    if func then func() end
                end
            end)
        end
    end
end)

-- Cleanup
Data.screenGui.AncestryChanged:Connect(function()
    if not Data.screenGui.Parent and Data.loopConnection then
        Data.loopConnection:Disconnect()
    end
    if not Data.screenGui.Parent and Data.RemoteSpy then
        pcall(Data.RemoteSpy.stopHook)
