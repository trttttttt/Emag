-- Cari boss dalam workspace.Boss
local bossCacheTime, bossCacheResult = 0, nil

local function findBoss(name)
	if not name then return nil end

	if bossCacheResult and isAlive(bossCacheResult) and norm(bossCacheResult.Name) == norm(name) then
		return bossCacheResult
	end
	bossCacheResult = nil

	if tick() - bossCacheTime < 0.1 then return nil end
	bossCacheTime = tick()

	local folder = workspace:FindFirstChild("Boss")
	if not folder then return nil end

	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("Model") and norm(d.Name) == norm(name) and isAlive(d) then
			bossCacheResult = d
			return d
		end
	end
	return nil
end

-- DevilBoat / Kraken dalam workspace.Mob (paling dekat dulu)
local function pickSpecialTarget(fromPos)
	local wanted = {}
	if devilFarm then wanted.devilboat = true end
	if krakenFarm then wanted.kraken = true end

	local function scan(list)
		local best, bestDist = nil, math.huge
		for _, mob in ipairs(list) do
			if wanted[norm(mob.Name)] and isAlive(mob) then
				local cf = getMobCFrame(mob)
				if cf then
					local d = (cf.Position - fromPos).Magnitude
					if d < bestDist then
						best, bestDist = mob, d
					end
				end
			end
		end
		return best
	end

	return scan(refreshMobs(0.5)) or scan(refreshMobs(0.2))
end

-- Raid: ArmorBall1 & ArmorBall2 mesti hilang / mati dulu, baru mob lain
local function pickRaidTarget(fromPos)
	local fight = workspace:FindFirstChild("Boss Fight")
	if not fight then return nil end

	local boss = fight:FindFirstChild(RAID_BOSS)
	if boss then
		for _, name in ipairs({ "ArmorBall1", "ArmorBall2" }) do
			local ball = boss:FindFirstChild(name)
			if ball and isAlive(ball) then
				return ball
			end
		end
	end

	-- bagi masa ArmorBall load sebelum serang mob lain
	if raidSeenAt and tick() - raidSeenAt < 1.5 then
		return nil
	end

	local best, bestDist = nil, math.huge
	local function consider(m)
		if m.Name ~= "ArmorBall1" and m.Name ~= "ArmorBall2" and isAlive(m) then
			local cf = getMobCFrame(m)
			if cf then
				local d = (cf.Position - fromPos).Magnitude
				if d < bestDist then
					best, bestDist = m, d
				end
			end
		end
	end

	for _, d in ipairs(fight:GetDescendants()) do
		if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") then
			consider(d)
		end
	end
	if boss and boss:IsA("Model") then
		consider(boss)
	end
	if not best then
		for _, c in ipairs(fight:GetChildren()) do
			if c:IsA("Model") then
				consider(c)
			end
		end
	end
	return best
end

-- Villain: mob dekat ChestRef (workspace.Mob dalam radius, atau Humanoid dalam group ChestRef tu)
local villainGroupCache, villainGroupTime = {}, 0

local function getVillainCandidates()
	local list = {}
	for _, mob in ipairs(refreshMobs(0.5)) do
		table.insert(list, mob)
	end

	if villainGroup then
		if tick() - villainGroupTime > 0.5 then
			villainGroupTime = tick()
			local found = {}
			for _, d in ipairs(villainGroup:GetDescendants()) do
				if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid")
					and not Players:GetPlayerFromCharacter(d) then
					table.insert(found, d)
				end
			end
			villainGroupCache = found
		end
		for _, m in ipairs(villainGroupCache) do
			table.insert(list, m)
		end
	end

	return list
end

local function pickVillainTarget(fromPos)
	if villainPhase ~= "clear" or not villainPos then return nil end

	local best, bestDist = nil, math.huge
	for _, mob in ipairs(getVillainCandidates()) do
		if isAlive(mob) then
			local cf = getMobCFrame(mob)
			if cf and (cf.Position - villainPos).Magnitude <= VILLAIN_RADIUS then
				local d = (cf.Position - fromPos).Magnitude
				if d < bestDist then
					best, bestDist = mob, d
				end
			end
		end
	end
	return best
end

