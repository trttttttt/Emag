local function mobNear()
	local root = getRoot()
	if not root then return false end

	-- had "near" ikut jarak dan tinggi farm supaya skill tak terhalang
	local dist, height = getFarmOffsets()
	local limit = math.max(NEAR_DISTANCE, math.sqrt(dist ^ 2 + height ^ 2) + 10)

	-- target farm semasa (boss, raid, quest) pun dikira
	if currentTarget and isAlive(currentTarget) then
		local tcf = getMobCFrame(currentTarget)
		if tcf and (tcf.Position - root.Position).Magnitude <= limit then
			return true
		end
	end
	for _, mob in ipairs(refreshMobs(0.5)) do
		if isAlive(mob) then
			local cf = getMobCFrame(mob)
			if cf and (cf.Position - root.Position).Magnitude <= limit then
				return true
			end
		end
	end
	return false
end

-- Konteks skill: antara Raid, Dungeon dan Auto Skill biasa, yang paling akhir kau hidupkan jadi prioriti
local function skillContext()
	local best, bestStamp = nil, -1
	if raidFarm and raidStamp > bestStamp then
		best, bestStamp = "raid", raidStamp
	end
	if autoDungeon and dungeonStamp > bestStamp then
		best, bestStamp = "dungeon", dungeonStamp
	end
	if autoSkill and generalStamp > bestStamp then
		best, bestStamp = "general", generalStamp
	end
	return best
end

local function skillWanted()
	local ctx = skillContext()
	if ctx == "raid" then
		return raidSkill and raidFightActive()
	elseif ctx == "dungeon" then
		-- dungeon ada isi DAN ada mob dekat
		return dungeonSkill and dungeonActive() and mobNear()
	elseif ctx == "general" then
		return true
	end
	return farmActive()
end

-- Pilih mob: Farm Near Mob = paling dekat (apa-apa nama), kalau tak = ikut dropdown
local function scanForTarget(mobs, fromPos)
	local best, bestDist = nil, math.huge
	for _, mob in ipairs(mobs) do
		if isAlive(mob) and (nearFarm or mob.Name == selectedMob) then
			local cf = getMobCFrame(mob)
			if cf then
				local d = (cf.Position - fromPos).Magnitude
				if (not nearFarm or d <= FARM_NEAR_RADIUS) and d < bestDist then
					best, bestDist = mob, d
				end
			end
		end
	end
	return best
end

-- RocketTower (Event Moon)
local function getTowerPos()
	local island = workspace:FindFirstChild("island")
	local moon = island and island:FindFirstChild("Moon")
	local tower = moon and moon:FindFirstChild("RocketTower")
	if not tower then return nil end

	local ok, cf = pcall(function()
		return tower:GetPivot()
	end)
	if ok then
		return cf.Position
	end

	local part = tower:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

-- Mob Event Moon: workspace.Mob dulu, kalau takde mob hidup cari Humanoid dalam workspace.island
local moonCache, moonCacheTime = {}, 0

local function refreshMoonMobs(maxAge)
	if tick() - moonCacheTime < maxAge then
		return moonCache
	end
	moonCacheTime = tick()

	local list, seen, anyAlive = {}, {}, false
	for _, mob in ipairs(refreshMobs(maxAge)) do
		seen[mob] = true
		table.insert(list, mob)
		if isAlive(mob) then
			anyAlive = true
		end
	end

	if not anyAlive then
		local island = workspace:FindFirstChild("island")
		if island then
			for _, d in ipairs(island:GetDescendants()) do
				if d:IsA("Model") and not seen[d] and d:FindFirstChildOfClass("Humanoid")
					and not Players:GetPlayerFromCharacter(d) then
					seen[d] = true
					table.insert(list, d)
				end
			end
		end
	end

	moonCache = list
	return list
end

-- Jarak mob ke tower kalau mob tu dapat prioriti (dekat atau mendekat), kalau tak nil
local function towerPriorityDist(mob, towerPos)
	local cf = getMobCFrame(mob)
	if not cf then return nil end

	local toTower = towerPos - cf.Position
	local dTower = toTower.Magnitude
	local approaching = false

	local hrp = mob:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") and dTower > 0.01 then
		approaching = hrp.AssemblyLinearVelocity:Dot(toTower.Unit) > MOVING_SPEED
	end

	if dTower <= TOWER_RADIUS or (approaching and dTower <= TOWER_APPROACH_RADIUS) then
		return dTower
	end
	return nil
end

-- Prioriti: mob dekat / mendekat ke RocketTower (yang paling dekat tower dulu), kalau takde: mob paling dekat dengan player
local function pickMoonTarget(fromPos)
	local towerPos = getTowerPos()

	-- kekal pada target semasa kalau dia masih mob prioriti (elak tukar-tukar target)
	if towerPos and currentTarget and isAlive(currentTarget) and towerPriorityDist(currentTarget, towerPos) then
		moonPriority = true
		return currentTarget
	end

	local bestPriority, bestPriorityDist = nil, math.huge
	local bestNear, bestNearDist = nil, math.huge

	local function scan(list)
		for _, mob in ipairs(list) do
			if isAlive(mob) then
				local cf = getMobCFrame(mob)
				if cf then
					if towerPos then
						local dTower = towerPriorityDist(mob, towerPos)
						if dTower and dTower < bestPriorityDist then
							bestPriority, bestPriorityDist = mob, dTower
						end
					end

					local dPlayer = (cf.Position - fromPos).Magnitude
					if dPlayer < bestNearDist then
						bestNear, bestNearDist = mob, dPlayer
					end
				end
			end
		end
	end

	local mobs = refreshMoonMobs(0.5)
	scan(mobs)
	if not bestPriority and not bestNear then
		mobs = refreshMoonMobs(0.2)
		scan(mobs)
	end

	moonMobCount = #mobs
	moonPriority = bestPriority ~= nil
	return bestPriority or bestNear
end

