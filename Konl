-- Baca combat dari inventory (Backpack + yang tengah equip)
local function getCombatNames()
	local seen, names = {}, {}

	local function scan(container)
		if not container then return end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and SKILLS[t.Name] and not seen[t.Name] then
				seen[t.Name] = true
				table.insert(names, t.Name)
			end
		end
