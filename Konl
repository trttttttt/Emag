task.spawn(function()
	local doneAt = {}

	while alive() do
		if villainFarm then
			local root = getRoot()
			local spawnRoot = workspace:FindFirstChild("MobSpawnGroup")
			local best, bestDist = nil, math.huge

			-- cari ChestRef paling dekat yang belum dibuat baru-baru ni
			if spawnRoot and root then
				for _, group in ipairs(spawnRoot:GetChildren()) do
					local ref = group:FindFirstChild("ChestRef", true)
					if ref and (not doneAt[ref] or tick() - doneAt[ref] > VILLAIN_COOLDOWN) then
						local real = resolveChestRef(ref)
						local pos = real and getInstancePos(real)
						if pos then
							local d = (pos - root.Position).Magnitude
							if d < bestDist then
								best = { ref = ref, real = real, pos = pos, group = group }
								bestDist = d
							end
						end
					end
				end
			end

			if best then
				villainPos = best.pos
				villainGroup = best.group

				-- 1. teleport ke ChestRef
				villainPhase = nil
				villainBusy = true
				teleportTo(best.pos)
				task.wait(0.4)
				villainBusy = false

				-- 2. bunuh mob dekat ChestRef sampai takde lagi
				villainPhase = "clear"
				local started = tick()
				local emptySince = tick()
				while alive() and villainFarm and tick() - started < VILLAIN_MAX_CLEAR do
					if pickVillainTarget(best.pos) then
						emptySince = nil
					else
						emptySince = emptySince or tick()
						if tick() - emptySince >= VILLAIN_EMPTY_WAIT then break end
					end
					task.wait(0.2)
				end
				villainPhase = nil

				-- 3. teleport balik ke ChestRef dan fire proximity prompt
				if alive() and villainFarm then
