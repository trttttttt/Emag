-- Mob
local mobCache = {}
local mobCacheTime = 0

local function refreshMobs(maxAge)
	if tick() - mobCacheTime < maxAge then
		return mobCache
	end
	mobCacheTime = tick()

	local list = {}
	local folder = workspace:FindFirstChild("Mob")
	if folder then
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") then
				table.insert(list, d)
			end
		end
		-- kalau mob takde Humanoid, guna Model terus bawah folder
		if #list == 0 then
			for _, c in ipairs(folder:GetChildren()) do
				if c:IsA("Model") then
					table.insert(list, c)
				end
			end
		end
	end

	mobCache = list
	return list
end

local function isAlive(mob)
	if not mob or not mob.Parent or not mob:IsDescendantOf(workspace) then
		return false
	end
	local hum = mob:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return false
	end
	return true
end

local function getMobCFrame(mob)
	local hrp = mob:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp.CFrame
	end
	local ok, cf = pcall(function()
		return mob:GetPivot()
	end)
	if ok then
		return cf
	end
end

local function getMobNames()
	local seen, names = {}, {}
	for _, mob in ipairs(refreshMobs(0)) do
		if not seen[mob.Name] then
			seen[mob.Name] = true
			table.insert(names, mob.Name)
		end
	end
	table.sort(names)
	return names
end

local function mobNear()
	local root = getRoot()
	if not root then return false end
	for _, mob in ipairs(refreshMobs(0.5)) do
		if isAlive(mob) then
			local cf = getMobCFrame(mob)
			if cf and (cf.Position - root.Position).Magnitude <= NEAR_DISTANCE then
				return true
			end
		end
	end
	return false
end

-- Pilih mob: Farm Near Mob = paling dekat (apa-apa nama), kalau tak = ikut dropdown
local function scanForTarget(mobs, fromPos)
	local best, bestDist = nil, math.huge
	for _, mob in ipairs(mobs) do
		if isAlive(mob) and (nearFarm or mob.Name == selectedMob) then
			local cf = getMobCFrame(mob)
			if cf then
				local d = (cf.Position - fromPos).Magnitude
				if (not nearFarm or d <= FARM_NEAR_RADIUS) and d < bestDist then
					best, bestDist = mob, d
				end
			end
		end
	end
	return best
end

-- RocketTower (Event Moon)
local function getTowerPos()
	local island = workspace:FindFirstChild("island")
	local moon = island and island:FindFirstChild("Moon")
	local tower = moon and moon:FindFirstChild("RocketTower")
	if not tower then return nil end

	local ok, cf = pcall(function()
		return tower:GetPivot()
	end)
	if ok then
		return cf.Position
	end

	local part = tower:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

-- Prioriti: mob dekat / mendekat ke RocketTower (yang paling dekat tower dulu), kalau takde: mob paling dekat dengan player
local function pickMoonTarget(fromPos)
	local towerPos = getTowerPos()
	local bestPriority, bestPriorityDist = nil, math.huge
	local bestNear, bestNearDist = nil, math.huge

	local function scan(list)
		for _, mob in ipairs(list) do
			if isAlive(mob) then
				local cf = getMobCFrame(mob)
				if cf then
					local pos = cf.Position

					if towerPos then
						local toTower = towerPos - pos
						local dTower = toTower.Magnitude
						local approaching = false

						local hrp = mob:FindFirstChild("HumanoidRootPart")
						if hrp and hrp:IsA("BasePart") and dTower > 0.01 then
							approaching = hrp.AssemblyLinearVelocity:Dot(toTower.Unit) > MOVING_SPEED
						end

						if (dTower <= TOWER_RADIUS or (approaching and dTower <= TOWER_APPROACH_RADIUS))
							and dTower < bestPriorityDist then
							bestPriority, bestPriorityDist = mob, dTower
						end
					end

					local dPlayer = (pos - fromPos).Magnitude
					if dPlayer <= FARM_NEAR_RADIUS and dPlayer < bestNearDist then
						bestNear, bestNearDist = mob, dPlayer
					end
				end
			end
		end
	end

	scan(refreshMobs(0.5))
	if not bestPriority and not bestNear then
		scan(refreshMobs(0.2))
	end

	moonPriority = bestPriority ~= nil
	return bestPriority or bestNear
end

local function pickTarget(fromPos)
	if moonFarm then
		return pickMoonTarget(fromPos)
	end
	if not nearFarm and not selectedMob then return nil end
	local target = scanForTarget(refreshMobs(0.5), fromPos)
	if not target then
		target = scanForTarget(refreshMobs(0.2), fromPos)
	end
	return target
end

