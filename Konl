-- Status Event Moon
task.spawn(function()
	local last = ""
	while alive() do
		local text
		if not moonFarm then
			text = "Status: idle"
		elseif not getTowerPos() then
			text = "Status: RocketTower tak jumpa, farm mob terdekat"
		elseif moonPriority then
			text = "Status: prioriti mob dekat RocketTower"
		else
			text = "Status: takde mob dekat tower, farm mob terdekat"
		end

		if text ~= last then
			last = text
			pcall(function()
				MoonStatus:Set(text)
			end)
		end
		task.wait(0.5)
	end
end)

