-- Mob
local mobCache = {}
local mobCacheTime = 0

local function refreshMobs(maxAge)
	if tick() - mobCacheTime < maxAge then
		return mobCache
	end
	mobCacheTime = tick()

	local list = {}
	local folder = workspace:FindFirstChild("Mob")
	if folder then
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("Model") and (d:FindFirstChildOfClass("Humanoid") or SPECIAL_NAMES[norm(d.Name)]) then
				table.insert(list, d)
			end
		end
		-- kalau mob takde Humanoid, guna Model terus bawah folder
		if #list == 0 then
			for _, c in ipairs(folder:GetChildren()) do
				if c:IsA("Model") then
					table.insert(list, c)
				end
			end
		end
	end

	mobCache = list
	return list
end

local function isAlive(mob)
	if not mob or not mob.Parent or not mob:IsDescendantOf(workspace) then
		return false
	end
	local hum = mob:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then
		return false
	end
	return true
end

local function getMobCFrame(mob)
	local hrp = mob:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp.CFrame
	end
	local ok, cf = pcall(function()
		return mob:GetPivot()
	end)
	if ok then
		return cf
	end
end

