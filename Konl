local function loadSkills()
	local skills = {}

	-- cuba baca terus dari module supaya sentiasa terkini
	local ok, data = pcall(function()
		return require(ReplicatedStorage.Modules.SkillList)
	end)
	if ok and type(data) == "table" then
		for name, keys in pairs(data) do
			if type(keys) == "table" then
				local list = {}
				for _, k in ipairs(keys) do
					table.insert(list, string.lower(k))
				end
				skills[name] = list
			end
		end
	end

	-- kalau gagal, guna senarai dalam script
	if next(skills) == nil then
		for _, name in ipairs(FOUR) do
			skills[name] = { "z", "x", "c", "v" }
		end
		for _, name in ipairs(FIVE) do
			skills[name] = { "z", "x", "c", "v", "f" }
		end
	end

	return skills
end

