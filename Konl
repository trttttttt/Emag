local function loadSkills()
	local skills = {}

	-- cuba baca terus dari module supaya sentiasa terkini
	local ok, data = pcall(function()
		return require(ReplicatedStorage.Modules.SkillList)
	end)
	if ok and type(data) == "table" then
		for name, keys in pairs(data) do
			if type(keys) == "table" then
				local list = {}
				for _, k in ipairs(keys) do
					table.insert(list, string.lower(k))
				end
				skills[name] = list
			end
		end
	end

	-- kalau gagal, guna senarai dalam script
	if next(skills) == nil then
		for _, name in ipairs(FOUR) do
			skills[name] = { "z", "x", "c", "v" }
		end
		for _, name in ipairs(FIVE) do
			skills[name] = { "z", "x", "c", "v", "f" }
		end
	end

	return skills
end

local SKILLS = loadSkills()

-- Baca combat dari inventory (Backpack + yang tengah equip)
local function getCombatNames()
	local seen, names = {}, {}

	local function scan(container)
		if not container then return end
		for _, t in ipairs(container:GetChildren()) do
			if t:IsA("Tool") and SKILLS[t.Name] and not seen[t.Name] then
				seen[t.Name] = true
				table.insert(names, t.Name)
			end
		end
	end

	scan(player:FindFirstChildOfClass("Backpack"))
	scan(player.Character)

	-- kalau inventory tak jumpa apa-apa, guna senarai penuh
	if #names == 0 then
		for name in pairs(SKILLS) do
			table.insert(names, name)
		end
	end

	table.sort(names)
	return names
end

