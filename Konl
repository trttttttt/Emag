local FARM_NEAR_RADIUS = 700 -- jarak scan untuk Farm Near Mob
local TOWER_RADIUS = 400 -- mob dalam jarak ni dari RocketTower dapat prioriti
local TOWER_APPROACH_RADIUS = 600 -- mob yang bergerak menuju tower dalam jarak ni pun dapat prioriti

