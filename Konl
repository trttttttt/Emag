-- Auto Equip
task.spawn(function()
	while alive() do
		if (autoEquipM1 or farmActive()) and selectedCombat then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				local want = string.lower(selectedCombat)
				local equipped = false

				for _, t in ipairs(char:GetChildren()) do
					if t:IsA("Tool") and string.lower(t.Name) == want then
						equipped = true
						break
					end
				end

				if not equipped then
					local backpack = player:FindFirstChildOfClass("Backpack")
					if backpack then
						for _, t in ipairs(backpack:GetChildren()) do
							if t:IsA("Tool") and string.lower(t.Name) == want then
								pcall(hum.EquipTool, hum, t)
								break
							end
						end
					end
				end
			end
		end
		task.wait(0.5)
	end
end)

-- Auto M1 (jalan bila toggle M1 ON atau farm ON)
task.spawn(function()
	while alive() do
		if selectedCombat and (autoEquipM1 or farmActive()) then
			fire(selectedCombat, "hit")
		end
		task.wait(M1_DELAY)
	end
end)

-- Auto Skill (jalan bila toggle Skill ON atau farm ON)
task.spawn(function()
	while alive() do
		local keys = selectedCombat and SKILLS[selectedCombat]
		if keys and (autoSkill or farmActive()) then
			for _, key in ipairs(keys) do
				if not alive() or not (autoSkill or farmActive()) then break end
				if selectedSkills[key] then
					if not skillNearOnly or mobNear() then
						fire(selectedCombat, key)
					end
					task.wait(SKILL_DELAY)
				end
			end
			task.wait(0.02)
		else
			task.wait(0.2)
		end
	end
end)

-- Mob Farm: teleport ikut mob setiap frame
local target = nil
local lastMoonPick = 0

local function followStep(dt)
	if not farmActive() then
		target = nil
		return
	end

	local root = getRoot()
	if not root then return end

	-- mob mati / hilang: terus tukar ke yang lain
	local needPick = not target or not isAlive(target)

	-- Event Moon: semak semula kerap supaya mob dekat RocketTower dapat prioriti
	if moonFarm and tick() - lastMoonPick >= 0.3 then
		needPick = true
	end

	if needPick then
		lastMoonPick = tick()
		target = pickTarget(root.Position)
	end
	if not target then return end

	local cf = getMobCFrame(target)
	if not cf then
		target = nil
		return
	end

	local mobPos = cf.Position

	-- arah depan mob (rata, tak ikut senget ke atas/bawah)
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(root.Position.X - mobPos.X, 0, root.Position.Z - mobPos.Z)
	end
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, 1)
	end
	look = look.Unit

	-- anggar kedudukan mob frame seterusnya supaya tak ketinggalan
	local hrp = target:FindFirstChild("HumanoidRootPart")
	local mobVel = (hrp and hrp:IsA("BasePart")) and hrp.AssemblyLinearVelocity or Vector3.zero
	local flatVel = Vector3.new(mobVel.X, 0, mobVel.Z)
	local leadTime = 0
	if flatVel.Magnitude > MOVING_SPEED then
		-- mob tengah bergerak: lead ikut ping supaya tak ketinggalan
		local ping = 0
		pcall(function()
			ping = player:GetNetworkPing()
		end)
		leadTime = math.min((dt or 0) + ping * 2, MAX_LEAD)
	end
	local lead = flatVel * leadTime
	local futurePos = mobPos + lead

	-- duduk depan mob, jarak tetap, mengadap mob
	local pos = Vector3.new(futurePos.X, mobPos.Y + FARM_HEIGHT, futurePos.Z) + look * FARM_DISTANCE
	root.CFrame = CFrame.lookAt(pos, Vector3.new(futurePos.X, pos.Y, futurePos.Z))

	-- ikut kelajuan mob supaya steady
	root.AssemblyLinearVelocity = mobVel
	root.AssemblyAngularVelocity = Vector3.zero
end

-- kemas kini dua kali setiap frame (sebelum physics dan lepas physics) supaya rapat dengan mob laju
local function bind(signal)
	local conn
	conn = signal:Connect(function(dt)
		if not alive() then
			conn:Disconnect()
			return
		end
		followStep(dt)
	end)
end

