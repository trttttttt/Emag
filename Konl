-- Dungeon: mob dekat (Humanoid dalam DungeonMap + mob workspace.Mob yang dekat dengan kau)
local dungeonCache, dungeonCacheTime = {}, 0

local function getDungeonCandidates()
	if tick() - dungeonCacheTime < 0.3 then
		return dungeonCache
	end
	dungeonCacheTime = tick()

	local list, seen = {}, {}
	local map = workspace:FindFirstChild("DungeonMap")
	if map then
		for _, d in ipairs(map:GetDescendants()) do
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid")
				and not Players:GetPlayerFromCharacter(d) then
				seen[d] = true
				table.insert(list, d)
			end
		end
	end
	for _, mob in ipairs(refreshMobs(0.5)) do
		if not seen[mob] then
			table.insert(list, mob)
		end
	end

	dungeonCache = list
	return list
end

local function pickDungeonTarget(fromPos)
	local best, bestDist = nil, math.huge
	for _, mob in ipairs(getDungeonCandidates()) do
		if isAlive(mob) then
			local cf = getMobCFrame(mob)
			if cf then
				local d = (cf.Position - fromPos).Magnitude
				if d <= DUNGEON_SCAN_RADIUS and d < bestDist then
					best, bestDist = mob, d
				end
			end
		end
	end
	return best
end

-- Level player (cuba beberapa tempat biasa)
local function getPlayerLevel()
	local names = { "Level", "Lvl", "level" }
	local containers = {
		player:FindFirstChild("leaderstats"),
		player:FindFirstChild("Data"),
		player:FindFirstChild("PlayerData"),
	}

	for _, n in ipairs(names) do
		for _, c in ipairs(containers) do
			local v = c and c:FindFirstChild(n)
			if v and v:IsA("ValueBase") then
				local num = tonumber(v.Value)
				if num then return num end
			end
		end
		local attr = tonumber(player:GetAttribute(n))
		if attr then return attr end
	end
	return nil
end

-- Quest mana: pilihan manual, atau auto ikut level
local function getQuestIndex()
	if selectedQuest then
		local manual = string.match(selectedQuest, "^Quest (%d+)")
		if manual then
			return tonumber(manual)
		end
	end

	local level = getPlayerLevel()
	if not level then return nil end

	local idx = 1
	for i, lv in ipairs(QUEST_LEVELS) do
		if level >= lv then
			idx = i
		end
	end
	return idx
end

-- Mob quest = mob dekat NPC quest
local function pickQuestTarget(fromPos)
	if not questPos then return nil end

	local function scan(list)
		local best, bestDist = nil, math.huge
		for _, mob in ipairs(list) do
			if isAlive(mob) then
				local cf = getMobCFrame(mob)
				if cf and (cf.Position - questPos).Magnitude <= QUEST_RADIUS then
					local d = (cf.Position - fromPos).Magnitude
					if d < bestDist then
						best, bestDist = mob, d
					end
				end
			end
		end
		return best
	end

	return scan(refreshMobs(0.5)) or scan(refreshMobs(0.2))
end

local function pickTarget(fromPos)
	if bossFarm then
		return findBoss(selectedBoss)
	end
	if raidFarm then
		return pickRaidTarget(fromPos)
	end
	if dungeonActive() then
		return pickDungeonTarget(fromPos)
	end
	if moonFarm then
		return pickMoonTarget(fromPos)
	end
	if devilFarm or krakenFarm then
		local special = pickSpecialTarget(fromPos)
		if special then return special end
	end
	if villainFarm then
		local villain = pickVillainTarget(fromPos)
		if villain then return villain end
	end
	if questFarm then
		local quest = pickQuestTarget(fromPos)
		if quest then return quest end
	end
	if not (mobFarm or nearFarm) then return nil end
	if not nearFarm and not selectedMob then return nil end
	local target = scanForTarget(refreshMobs(0.5), fromPos)
	if not target then
		target = scanForTarget(refreshMobs(0.2), fromPos)
	end
	return target
end

