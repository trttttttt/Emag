-- Auto Skip dungeon: bila DungeonMap ada isi dan WaveUi.AutoSkip keluar, klik sekali ja
do
	local GuiService = game:GetService("GuiService")
	local VIM = nil
	pcall(function()
		VIM = game:GetService("VirtualInputManager")
	end)

	local function guiVisible(obj)
		local cur = obj
		while cur and cur ~= game do
			if cur:IsA("GuiObject") and not cur.Visible then return false end
			if cur:IsA("ScreenGui") and not cur.Enabled then return false end
			cur = cur.Parent
		end
		return true
	end

	local function isGreen(c)
		return c.G > c.R + 0.15 and c.G > c.B + 0.15
	end

	-- AutoSkip dianggap ON bila warnanya hijau
	local function skipIsOn(obj)
		if obj:IsA("GuiObject") and obj.BackgroundTransparency < 1 and isGreen(obj.BackgroundColor3) then
			return true
		end
		if (obj:IsA("ImageButton") or obj:IsA("ImageLabel")) and isGreen(obj.ImageColor3) then
			return true
		end
		return false
	end

	-- klik tetikus kat tengah butang
	local function clickGui(obj)
		if not VIM then return false end

		local target = obj
		if not obj:IsA("GuiButton") then
			target = obj:FindFirstChildWhichIsA("GuiButton", true) or obj
		end

		local c = target.AbsolutePosition + target.AbsoluteSize / 2
		local gui = target:FindFirstAncestorOfClass("ScreenGui")
		if gui and not gui.IgnoreGuiInset then
			c = c + GuiService:GetGuiInset()
		end
		local x, y = c.X + CLICK_OFFSET_X, c.Y + CLICK_OFFSET_Y

		local ok = pcall(function()
			VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
			task.wait(0.05)
			VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
		end)
		if not ok then
			ok = pcall(function()
				VIM:SendTouchEvent(1, 0, x, y)
				task.wait(0.05)
				VIM:SendTouchEvent(1, 2, x, y)
			end)
		end
		return ok
	end

	task.spawn(function()
		local clicked = false -- sekali setiap dungeon

		while alive() do
			if autoSkipDungeon and dungeonActive() then
				local gui = player:FindFirstChild("PlayerGui")
				local waveUi = gui and gui:FindFirstChild("WaveUi")
				local obj = waveUi and waveUi:FindFirstChild("AutoSkip", true)

				if obj and guiVisible(obj) and not clicked then
					clicked = true
					-- kalau dah hijau (dah ON), jangan klik supaya tak tertutup balik
					if not skipIsOn(obj) then
						clickGui(obj)
					end
				end
			else
				clicked = false
			end
			task.wait(0.5)
		end
	end)
end

