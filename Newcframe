-- Helper Functions
local function ParseCFrame(str)
    local cleanStr = str:gsub("CFrame%.new%(", ""):gsub("%)", ""):gsub(" ", "")
    local coords = {}
    for num in cleanStr:gmatch("[^,]+") do
        table.insert(coords, tonumber(num))
    end
    
    if #coords >= 3 then
        return CFrame.new(coords[1], coords[2], coords[3])
    end
    return nil
end

local function GetCurrentCFrame()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local cf = char.HumanoidRootPart.CFrame
        return string.format("%.2f, %.2f, %.2f", cf.X, cf.Y, cf.Z)
    end
    return nil
end

local function TeleportToCFrame(cframe)
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = cframe
        return true
    end
    return false
end

-- Stops the spam-teleport loop for a given section+slot, if running.
local function StopSpam(section, slotNum)
    local key = section .. "_" .. slotNum
    ActiveSpamLoops[key] = nil
end

-- Starts a spam-teleport loop for a given section+slot: repeatedly sets the
-- character's CFrame to the slot's saved position every SpamSpeed seconds,
-- until StopSpam is called (toggle off, slot deleted, or section switched
-- away doesn't stop it — spam continues across section views on purpose,
-- since the loop is independent of which section is currently displayed).
local function StartSpam(section, slotNum)
    local key = section .. "_" .. slotNum
    if ActiveSpamLoops[key] then return end -- already running
    ActiveSpamLoops[key] = true

    task.spawn(function()
        while ActiveSpamLoops[key] do
            local cf = SavedCFrames[section][slotNum]
            if not cf then
                -- Slot was deleted mid-spam — stop cleanly.
                ActiveSpamLoops[key] = nil
                break
            end
            TeleportToCFrame(cf)
            task.wait(SpamSpeed)
        end
    end)
end

function UpdateSlotButtons()
    for i = 1, 10 do
        local slot = SlotButtons[i]
        local key = CurrentSection .. "_" .. i

        if SavedCFrames[CurrentSection][i] then
            slot.Status.Text = "●"
            slot.Status.TextColor3 = Color3.fromRGB(0, 255, 0)
            slot.TPBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
            slot.SpamBtn.BackgroundColor3 = ActiveSpamLoops[key] and Color3.fromRGB(255, 0, 200) or Color3.fromRGB(150, 0, 200)
        else
            slot.Status.Text = "○"
            slot.Status.TextColor3 = Color3.fromRGB(150, 150, 150)
            slot.TPBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            slot.SpamBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        end

        slot.SpamBtn.Text = ActiveSpamLoops[key] and "Stop" or "Spam"
    end
end

